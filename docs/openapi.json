          "400": {
            "description": "Datos de entrada inválidos, platos de diferente restaurante o platos inactivos"
          },
          "403": {
            "description": "Acceso denegado: se requiere rol CLIENTE"
          },
          "404": {
            "description": "Restaurante o plato no encontrado"
          },
          "409": {
