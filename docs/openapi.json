            "name": "estado",
            "in": "query",
            "description": "Estado por el cual filtrar los pedidos (PENDIENTE, EN_PREPARACION, LISTO, ENTREGADO, CANCELADO). Por defecto PENDIENTE",
            "required": false,
            "schema": {
              "type": "string",
              "default": "PENDIENTE"
            }
          },
          {
            "name": "idRestaurante",
            "in": "query",
            "description": "Identificador opcional del restaurante (si no se proporciona se resuelve del empleado autenticado)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
